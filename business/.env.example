# AI事業会社 環境変数サンプル。`cp business/.env.example business/.env` して値を設定する。
# 未設定でも business/api はSQLiteでゼロコンフィグ起動でき、business/scripts はモックモードで動作する。

# --- Claude / Anthropic (business/scripts の自動化に使用) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- 他社AI（必要に応じて）---
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
PERPLEXITY_API_KEY=

# --- business/api ---
PORT=4000
DATABASE_PATH=./data/crm.sqlite3

# --- Supabase移行時（任意） ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- 決済 ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- 通知/連携（任意） ---
SLACK_WEBHOOK_URL=
LINE_CHANNEL_ACCESS_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- n8n（任意） ---
CRM_API_BASE=http://localhost:4000
